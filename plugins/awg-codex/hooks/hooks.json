{
  "description": "Adds AWG session context and checks bound structured file writes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','session_start.py'),run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','session_start.py'),run_name='__main__')\"",
            "timeout": 5,
            "statusMessage": "Loading AWG project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','pre_tool_use.py'),run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','pre_tool_use.py'),run_name='__main__')\"",
            "timeout": 5,
            "statusMessage": "Checking AWG task write scope"
          }
        ]
      }
    ]
  }
}
