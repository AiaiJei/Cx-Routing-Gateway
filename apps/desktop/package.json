{
  "name": "@cx-routing-gateway/desktop-ui",
  "version": "1.0.2",
  "description": "Cx-Routing Gateway Desktop workspace and local runtime shell",
  "author": "Cx-Routing Gateway contributors",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop:dev": "electron .",
    "desktop:prod": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
